# DIALECT: one of mysql | postgres | mssql | demo
# demo needs no external database - it boots an embedded SQLite DB seeded
# with the sample e-commerce schema (see src/dialects/demo.js).
DIALECT=demo

DB_HOST=localhost
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

PORT=3000

# Required for any non-local deployment: every generated CRUD route requires
# this value in the x-api-key header when it is set. Leave unset only for
# local/demo experimentation.
API_KEY=

DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
